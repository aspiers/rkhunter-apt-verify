#!/bin/sh
#
# Update rkhunter's file-properties baseline after Debian package upgrades,
# but only when every change rkhunter sees is explained by a package dpkg
# just installed, and dpkg confirms that package's files are intact.
#
# Debian's own APT_AUTOGEN instead runs a full "rkhunter --propupd" after
# every dpkg run, which silently accepts any tampering into the baseline.
# The idea of gating the update on a pre-transaction check comes from
# https://github.com/sjinks/yum-plugin-rkhunter
#
# Called from apt via DPkg::Pre-Invoke ("pre") and DPkg::Post-Invoke
# ("post"); see 95rkhunter-apt-verify. Anything it declines to accept is
# left for rkhunter's normal daily report.

set -u
export LC_ALL=C

STATE_DIR=/run/rkhunter-apt-verify
STATE=$STATE_DIR/state
PRECHECK_LOG=$STATE_DIR/precheck.log
POSTCHECK_LOG=$STATE_DIR/postcheck.log
DPKG_LOG=/var/log/dpkg.log
TAG=rkhunter-apt-verify

log() {
    logger -t "$TAG" -- "$*" 2>/dev/null
    echo "$TAG: $*" >&2
}

# The "properties" group (hashes, attributes, scripts, immutable) only
# runs per-file tests, so every warning it raises names a file.
check_properties() {
    rkhunter --check --sk --nocolors --rwo --enable properties \
        --logfile "$1" >/dev/null 2>&1
}

# Files rkhunter marked "[ Warning ]" in a check log.
warned_files() {
    sed -n 's/^\[[0-9:]*\]  *\(\/[^ ]*\)  *\[ Warning \]$/\1/p' "$1" | sort -u
}

pre() {
    mkdir -p "$STATE_DIR"
    offset=$(stat -c %s "$DPKG_LOG" 2>/dev/null || echo 0)

    # rkhunter exits non-zero on warnings as well as on errors; either way
    # we can't vouch for the current baseline, so treat both as dirty.
    if check_properties "$PRECHECK_LOG"; then
        echo "clean $offset" >"$STATE"
    else
        echo "dirty $offset" >"$STATE"
        log "rkhunter warned before this dpkg run, so its baseline will not be updated (see $PRECHECK_LOG)"
    fi
}

# Packages dpkg reported as installed since the pre-check, without arch.
changed_packages() {
    tail -c +"$(($1 + 1))" "$DPKG_LOG" \
        | awk '$3 == "status" && $4 == "installed" { sub(/:.*/, "", $5); print $5 }' \
        | sort -u
}

# Canonical paths of a package's files. Canonicalising matters for
# merged-/usr (/bin/ls is /usr/bin/ls) and for alternatives, where
# rkhunter watches /usr/bin/awk but dpkg lists /usr/bin/gawk.
package_paths() {
    dpkg -L "$1" 2>/dev/null | while IFS= read -r p; do
        [ -f "$p" ] && realpath -m -- "$p"
    done
}

post() {
    [ -r "$STATE" ] || return 0
    read -r status offset <"$STATE"
    rm -f "$STATE"
    [ "$status" = clean ] || return 0

    pkgs=$(changed_packages "$offset")
    [ -n "$pkgs" ] || return 0

    # The system was clean before dpkg ran, so whatever rkhunter warns
    # about now changed during this run.
    check_properties "$POSTCHECK_LOG" && return 0
    warned=$(warned_files "$POSTCHECK_LOG")
    if [ -z "$warned" ]; then
        log "rkhunter failed without naming any file, so its baseline will not be updated (see $POSTCHECK_LOG)"
        return 0
    fi

    verified=$(mktemp) || return 1
    trap 'rm -f "$verified"' EXIT
    for pkg in $pkgs; do
        # Ignore conffiles (flag "c"): local edits to them are expected.
        bad=$(dpkg --verify "$pkg" 2>&1 | grep -v '^.\{9\} c ')
        if [ -n "$bad" ]; then
            log "dpkg --verify $pkg failed: $(echo "$bad" | tr '\n' ' ')"
            continue
        fi
        package_paths "$pkg" >>"$verified"
    done

    unexplained=$(echo "$warned" | while IFS= read -r f; do
        grep -qxF -- "$(realpath -m -- "$f")" "$verified" || echo "$f"
    done)
    if [ -n "$unexplained" ]; then
        log "changes not explained by verified packages, so rkhunter's baseline will not be updated: $(echo "$unexplained" | paste -sd' ')"
        return 0
    fi

    # A full update rather than a per-file one: "--propupd <file>" also
    # adds every new watched file without asking, and a full update is
    # needed anyway to record files that newly installed packages added.
    # Everything rkhunter would change has just been accounted for.
    if rkhunter --propupd --nolog >/dev/null; then
        log "accepted verified package changes for: $(echo "$warned" | paste -sd' ')"
    else
        log "rkhunter --propupd failed"
    fi
}

command -v rkhunter >/dev/null || exit 0

case "${1:-}" in
    pre) pre ;;
    post) post ;;
    *) echo "usage: $0 pre|post" >&2; exit 2 ;;
esac
