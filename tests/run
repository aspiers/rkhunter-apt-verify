#!/bin/sh
# Run the test scenarios in a throwaway Debian 12 container.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
engine=$(command -v podman || command -v docker)
exec "$engine" run --rm \
    -v "$here/..:/hook:ro,Z" \
    -v "$here:/test:ro,Z" \
    docker.io/library/debian:12 sh /test/run-in-container.sh
